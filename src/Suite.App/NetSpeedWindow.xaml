<Window x:Class="Suite.App.NetSpeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suite NetSpeed"
        Width="168" Height="56"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF1E1E1E"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="OnDrag">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="改回桌面悬浮窗" Click="OnFloatFromMenu"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Border x:Name="RootBorder"
          CornerRadius="6"
          Padding="10,8"
          BorderThickness="1">
    <Grid x:Name="ContentHost" ClipToBounds="True">
      <StackPanel x:Name="RateStack" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock x:Name="DownText" FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="13" Text="↓ 0 B/s"/>
        <TextBlock x:Name="UpText" FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="13" Text="↑ 0 B/s"/>
        <TextBlock x:Name="SingleLineText" FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="13"
                   Text="↓ 0 B/s  ↑ 0 B/s" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
