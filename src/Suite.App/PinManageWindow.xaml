<Window x:Class="Suite.App.PinManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图管理"
        Width="360" Height="360"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        FontSize="13">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="关闭全部贴图" Padding="10,4" Margin="0,0,8,0" Click="OnCloseAll"/>
      <Button Content="关闭" Width="72" IsCancel="True" Click="OnClose"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" Text="当前没有贴图。" Margin="0,24,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
    <ListBox x:Name="List" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="聚焦" Width="48" Margin="4,0" Tag="{Binding Index}" Click="OnFocus"/>
              <Button Content="{Binding ThroughLabel}" Width="72" Margin="4,0" Tag="{Binding Index}" Click="OnThrough"/>
              <Button Content="关闭" Width="48" Margin="4,0" Tag="{Binding Index}" Click="OnCloseOne"/>
            </StackPanel>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
