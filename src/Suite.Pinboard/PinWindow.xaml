<Window x:Class="Suite.Pinboard.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suite 贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        PreviewMouseLeftButtonDown="OnDrag"
        PreviewMouseWheel="OnWheel"
        PreviewKeyDown="OnKey">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="不透明 100%" Click="OnOpacityFull"/>
      <MenuItem Header="75%" Click="OnOpacity75"/>
      <MenuItem Header="50%" Click="OnOpacity50"/>
      <MenuItem Header="25%" Click="OnOpacity25"/>
      <Separator/>
      <MenuItem x:Name="ClickThroughItem" Header="鼠标穿透" IsCheckable="True" Click="OnToggleClickThrough"/>
      <MenuItem Header="关闭" Click="OnCloseClick"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid Margin="22">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
    </Grid.LayoutTransform>
    <!-- 外层软彩虹光晕（模糊向外扩散，无白底硬框） -->
    <Border x:Name="GlowFarRing"
            IsHitTestVisible="False"
            BorderThickness="8"
            Background="Transparent"
            Opacity="0">
      <Border.BorderBrush>
        <LinearGradientBrush x:Name="GlowFarBrush" StartPoint="0,0" EndPoint="1,1">
          <GradientStop x:Name="Far0" Color="#FFFF6A8A" Offset="0"/>
          <GradientStop x:Name="Far1" Color="#FFFFB86A" Offset="0.16"/>
          <GradientStop x:Name="Far2" Color="#FFE8E070" Offset="0.33"/>
          <GradientStop x:Name="Far3" Color="#FF5EDC9A" Offset="0.5"/>
          <GradientStop x:Name="Far4" Color="#FF5AB8FF" Offset="0.66"/>
          <GradientStop x:Name="Far5" Color="#FFA878FF" Offset="0.83"/>
          <GradientStop x:Name="Far6" Color="#FFFF6A8A" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Effect>
        <BlurEffect Radius="24" KernelType="Gaussian"/>
      </Border.Effect>
    </Border>
    <!-- 近层更亮的彩虹描边光 -->
    <Border x:Name="GlowNearRing"
            IsHitTestVisible="False"
            BorderThickness="3"
            Background="Transparent"
            Opacity="0">
      <Border.BorderBrush>
        <LinearGradientBrush x:Name="GlowNearBrush" StartPoint="1,0" EndPoint="0,1">
          <GradientStop x:Name="Near0" Color="#FFFF6A8A" Offset="0"/>
          <GradientStop x:Name="Near1" Color="#FFFFB86A" Offset="0.2"/>
          <GradientStop x:Name="Near2" Color="#FF5EDC9A" Offset="0.4"/>
          <GradientStop x:Name="Near3" Color="#FF5AB8FF" Offset="0.6"/>
          <GradientStop x:Name="Near4" Color="#FFA878FF" Offset="0.8"/>
          <GradientStop x:Name="Near5" Color="#FFFF6A8A" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Effect>
        <BlurEffect Radius="10" KernelType="Gaussian"/>
      </Border.Effect>
    </Border>
    <Image x:Name="Picture" Stretch="Fill" SnapsToDevicePixels="True"
           Cursor="SizeAll"
           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
  </Grid>
</Window>
